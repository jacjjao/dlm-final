# Ollama — local LLM inference server
# Start with: ollama serve
# Pull model: ollama pull qwen2.5-coder:7b
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# ASR microservice — started via: cd asr && docker compose up
ASR_SERVICE_URL=http://localhost:8001

# Sandbox execution
SANDBOX_IMAGE=python:3.12-slim
SANDBOX_TIMEOUT=10
SANDBOX_MEMORY=256m

# Auto-debug retries (handled in frontend; backend has no limit)
MAX_DEBUG_RETRIES=3
